20260722-012/codex-implementation-reviewer-20260722T142504Z-73255.report.json\nA\t.outbox/runtime/RLY-20260722-012/codex-implementation-reviewer-20260722T142504Z-73255.result.json\nA\tmigrations/20260722_group_section_access.down.sql\nA\tmigrations/20260722_group_section_access.sql\nM\tsrc/api/sections/sectionController.js\nM\tsrc/daos/attachmentDAO.js\nM\tsrc/daos/binderDAO.js\nM\tsrc/daos/eventDao.js\nA\tsrc/daos/groupDAO.js\nM\tsrc/daos/sectionDAO.js\nM\tsrc/daos/syncDAO.js\nM\tsrc/daos/taskDAO.js\nM\tsrc/routes/binderRoutes.js\nA\tsrc/routes/groupRoutes.js\nM\tsrc/routes/index.js\nM\tsrc/services/binderService.js\nA\tsrc/services/groupService.js\nM\tsrc/services/mediaService.js\nM\tsrc/services/notificationService.js\nM\tsrc/services/sectionService.js\nM\tsrc/services/syncService.js\nmigrations/20260722_group_section_access.down.sql\nmigrations/20260722_group_section_access.sql\nsrc/api/notifications/notificationController.js\nsrc/api/sections/sectionController.js\nsrc/api/sync/syncController.js\nsrc/daos/attachmentDAO.js\nsrc/daos/groupDAO.js\nsrc/daos/messageDAO.js\nsrc/daos/notificationDAO.js\nsrc/daos/sectionDAO.js\nsrc/daos/syncDAO.js\nsrc/routes/attachmentRoutes.js\nsrc/routes/groupRoutes.js\nsrc/routes/notificationRoutes.js\nsrc/routes/sectionRoutes.js\nsrc/routes/syncRoutes.js\nsrc/services/groupService.js\nsrc/services/messageService.js\nsrc/services/notificationService.js\nsrc/services/sectionService.js\nsrc/services/syncService.js\n| `group_id UUID NULL → groups(id) ON DELETE SET NULL` | **섹션↔그룹 1:N 링크 (2026-07-22 N:N `section_groups` → 1:N 스칼라 FK 개정)**. 한 Section 은 최대 한 group 에 연결. NULL=미연결(private 이면 0-member lock). private 접근을 부여하는 유일한 링크. 여러 그룹이 필요하면 그룹을 새로 만들어 각 Section 에 연결. 그룹 삭제 시 SET NULL |\n| ~~`required_grade SMALLINT DEFAULT 3`~~ | **[제거됨 2026-07-22]** 수직 등급 임계 접근제어 폐지. private 접근은 오직 그룹 grant 경로. 등급별 노출은 그 등급 멤버로 그룹을 구성해 대체 |\n| `is_default BOOLEAN DEFAULT FALSE` | Binder 생성 시 자동으로 만들어지는 기본 섹션. **항상 public 고정 — private 전환·삭제 금지** (무해성 불변식 §7-A(3)) |\n\n> **접근 모델 단일 진실:** private Section 접근 판정·무해성 불변식·명찰 가시성·revoke 계약·grant-0·기술 AC 는 아래 **§7-A**. 권한 정책(D3/D4)은 [`standards/domain.md §3-6-A·§3-6-B`](../standards/domain.md)·[`SC-member-manage §10`](../binder/SC-member-manage.md).\n\n---\n\n## 7-A. Section 접근 모델 — 바인더 내 그룹 (2026-07-22 Gate 확정)\n\n> `groups`·`group_members` 2테이블 + `sections.group_id` 스칼라 FK + `binder_members.primary_group_id`. private Section 접근을 **단일 경로**(`sections.group_id→group_members`)로 판정하고, 소규모 바인더에 대해 그룹을 **완전 선택·무해**하게 유지한다. 섹션↔그룹은 **1:N**(한 Section 은 최대 한 group, 한 group 은 여러 Section 게이팅). 개인 직접 지정(`section_members`) 경로는 도입하지 않는다(중복 접근 경로 제거). 스키마 DDL: [`schema.md §5.6`](schema.md).\n\n### 그룹 2테이블 + 링크 컬럼 설계 의도\n\n| 테이블/컬럼 | 설계 의도 |\n|---|---|\n| `groups(id, binder_id, name, color, created_by, …, deleted_at)` | 바인더 내 수평 그룹(부서·팀·역할 라벨). `name`·`color` = 식별 라벨. `created_by` = 감사(users(id), 탈퇴 시 SET NULL). 그룹 존재 자체는 어떤 접근권한도 바꾸지 않는다 |\n| `group_members(id, group_id, user_id, …, deleted_at)` | 그룹 로스터. `user_id`(→users) = 설계 스펙 `binder_member_id`(바인더 범위는 group.binder_id 로 고정). 활성 유일성 `uq_group_members_active`(부분 유니크, soft delete 후 재추가 허용) |\n| `sections.group_id UUID NULL → groups(id) ON DELETE SET NULL` | Section↔group **1:N** grant (2026-07-22 N:N `section_groups` 테이블 → 1:N 스칼라 FK 개정). private Section 접근을 부여하는 유일한 링크. 한 Section 은 최대 한 group. NULL=미연결(private 이면 0-member lock). 별도 링크 테이블·활성 유일성 인덱스 불요 — 컬럼 자체가 유일성을 강제. 그룹 삭제 시 SET NULL |\n| `binder_members.primary_group_id UUID NULL → groups(id)` | 대표 그룹 명찰 (opt-in scalar, LWW 수렴). NULL 기본=명찰 없음. `is_primary` 다중-primary 오프라인 충돌 회피 위해 scalar 채택. 그룹 삭제 시 FK SET NULL, 탈퇴 시 서비스레이어 null 정리 |\n\n### (B) 접근 판정식 — 단일 경로\n\n```\n활성 binder_members(deleted_at IS NULL) AND (\n  access_scope = public\n  OR\n  (access_scope = private AND sections.group_id IS NOT NULL AND EXISTS(\n    SELECT 1 FROM group_members gm\n    WHERE gm.group_id = sections.group_id\n      AND gm.user_id = :current_user_id        -- 설계 스펙 binder_member_id (복합 PK 매핑)\n      AND gm.deleted_at IS NULL\n  ))\n)\n```\n\n- **public path 는 group JOIN 없이 short-circuit** — `access_scope=public` 이면 binder 활성 멤버 확인만 하고 종료(성능·데이터 독립성).\n- **`group_id IS NULL` (private 인데 미연결) = 0-member lock** — EXISTS 는 모두 false → D3 메타 오버사이트 외 접근자 0 (§F grant-0 잔존 상태).\n- **N:N JOIN 제거:** 링크가 단일 스칼라이므로 `section_groups` 중간 JOIN 없이 `group_members` 단일 EXISTS. 판정 비용·인덱스(`idx_gm_group`·`uq_group_members_active`) 단순화.\n- **리빙 propagation (스냅샷 아님):** query-time 조회 → 그룹에 멤버를 추가하면 그 그룹의 모든 private Section 접근이 **즉시** 반영된다. 별도 백필/재계산 이벤트 없음.\n\n### (C) 무해성 데이터 불변식 7+1 — 소규모 바인더 안전 보장\n\n무해성은 UI 숨김이 아니라 **데이터 불변식**으로 보장한다(그룹이 보여도·만져도 base 경험 무영향).\n\n1. 그룹 생성 자체는 어떤 Section 접근권한도 바꾸지 않는다. 접근 영향은 `sections.group_id` 명시 설정 시에만 발생.\n2. public Section 은 그룹 데이터와 독립 — 접근 쿼리는 `access_scope=public` 에서 binder 활성 멤버 확인만 하고 group JOIN 없이 종료.\n3. 기본 Section(`is_default`)은 항상 public 이며 그룹 연결 대상이 아님 (private 전환·삭제 금지, `group_id` 항상 NULL).\n4. private 전환은 `access_scope=private` 와 `group_id`(non-null) 를 **하나의 row UPDATE** 로 저장 (동일 row 원자 갱신 → 반쪽 설정 구조적 불가). private 인데 `group_id IS NULL` 인 직접 요청은 grant-0 차단(§F).\n5. 그룹 이름·컬러·멤버를 수정해도 Section 에 연결하지 않았다면 Calendar·Post·Section·기본 대화에 영향 없음.\n6. 0명 그룹·Section 미연결 그룹은 정상 데이터 (경고·설정 강요·온보딩 강제 없음).\n7. Binder 생성·가입·기본 Section 생성 시 group 행 자동 생성 없음.\n8. `binder_members.primary_group_id` 기본 NULL — 명찰도 opt-in (그룹 미사용 바인더는 명찰 슬롯 없이 순수 이름 렌더). §7 자동생성 없음과 대칭.\n\n### (D) 명찰 가시성 계약\n\n| sync 대상 | 스코프 |\n|---|---|\n| `groups(id, name, color)` | **binder 전 멤버 sync** (라벨=식별 메타, 로스터 미포함). 크로스-멤버 명찰 렌더용 |\n| `group_members` 로스터 | **접근-스코프 sync** (해당 그룹 멤버에게만) |\n| `sections.group_id` 링크 | **section 메타에 포함** — 접근자에게는 콘텐츠와 함께, 접근 상실자에게는 revoke 종단 delta 로 1회 도달(E항) |\n\n- 렌더: `binder_members.primary_group_id ⋈ groups(name,color)` JOIN (**스냅샷 금지·변경 즉시 반영**). `primary_group_id` 는 본인이 고른 라벨만 노출(그룹 로스터·게이팅 섹션 미노출).\n- 프라이버시: 민감정보는 private Section 에 두고 그룹명은 중립 라벨 컨벤션. (그룹명 자체 민감 우려 시 별도 `D-group-name-visibility` 로 member-scope 축소 가능 — 현 결정은 binder-wide.)\n\n### (E) Revoke 계약 — 원자 UPDATE + 5단계 pull (순환 필터 방지)\n\n**서버 측 revoke 액션은 단일 원자 UPDATE 다.** 관리자가 섹션의 연결 그룹을 바꾸거나 끊으면 `sections.group_id` 를 새 값(다른 group) 또는 NULL(→public 전환과 함께)로 **한 번의 row UPDATE** 로 갱신한다. 별도 링크 tombstone 다중 행 처리 없음(N:N `section_groups` 삭제 dance 제거).\n\nrevoke 신호는 **콘텐츠 접근 필터에 가려지지 않고**(순환 차단) 접근 상실자에게 도달해야 한다:\n- **사람 제거 원인** (그룹 탈퇴·강퇴): `group_members` `user_id = me` 스코프 tombstone 이 **항상 도달** (`idx_gm_user_sync`). 접근 상실과 무관하게 자기 멤버십 삭제는 미필터.\n- **섹션 relink/unlink 원인** (`sections.group_id` 변경): 변경 직전 접근권이 있던 멤버에게 해당 section 메타 row 의 **종단 delta 1회**(새 `group_id`/access 상실 신호)를 미필터로 전달한다. 그 이후 pull 부터는 접근집합에서 제외. 애초에 미접근이던 멤버에게는 section 이 전달된 적 없으므로 다른 그룹으로의 relink 가 새로 노출을 만들지 않는다.\n- `groups`: binder 멤버십 스코프 (`idx_groups_sync`).\n\nPull 당 적용 순서:\n1. **ACL delta pull** (`group_members` 자기 스코프 tombstone + `sections.group_id` 종단 delta + `groups`).\n2. **로컬 접근집합 재계산** (이전 vs 새 accessible section ID 비교 — `access_scope`·`group_id`·자기 `group_members` 로만 판정).\n3. **신규 접근 Section hydrate** (백필).\n4. **상실 Section purge** (섹션·메시지·첨부·embed·cursor).\n5. **잔여 접근 Section 일반 콘텐츠 delta.**\n\n- binder **완전 탈퇴는 별도 경로** (binder_members 삭제 → binder 전체 로컬 purge, 기존 동작). 본 계약은 **binder 멤버 유지 중 intra-binder 접근 상실**만 대상.\n\n### (F) grant-0 케이스분할\n\n> **동시성 race 자동 해소:** 링크가 단일 스칼라(`sections.group_id`)이므로 \"마지막 grant 를 두 관리자가 동시 제거해 grant-0\" 류의 다중행 race 가 구조적으로 불가능하다(구 N:N `section_groups` 는 행별 삭제라 race 존재). 동시 변경은 단일 컬럼 LWW 로 수렴.\n\n- **자동 public 전환: 전 경우 금지 (Blocker — 비밀 노출).**\n- 관리자 ACL 화면에서 **private Section 의 `group_id` 를 직접 NULL 로 설정**(연결 그룹 해제)하는 요청: 차단(422) → public 전환 또는 다른 그룹 지정 요구. UI 는 사전 경고/확인 노출.\n- **사람 제거 원인** (binder 탈퇴·강퇴·마지막 그룹 멤버 탈퇴): 탈퇴 차단 안 함 → private Section 은 \"유효 접근자 0명\" 상태로 잔존(`group_id` 는 유지되나 그룹 멤버 0명), D3 메타관리권(manager/master)에 \"대상 없음\" 노출·재배정 (**새 status/enum 없이 `group_id`⋈`group_members` 결과로 계산**).\n- **그룹 삭제**: FK `ON DELETE SET NULL` → 그 그룹이 게이팅하던 private Section 은 `group_id=NULL` 인 0-member lock 상태로 잔존(비밀 미노출). 삭제 확인 UI 는 마지막 구조적 grant 인 경우 대체 grant/public 을 요구·경고.\n\n### (G) 기술 Acceptance Criteria 4종 — 서버 필수 계약\n\n| AC | 계약 |\n|---|---|\n| **AC1 revoke 신호 전달** | 접근 잃은 유저에게 자기 `group_members` 삭제 tombstone(사람 제거 원인)·영향 section 의 `group_id` 변경 종단 delta(relink/unlink 원인)가 **새 권한 필터에 가려지지 않고** 도달 (E항 스코프·순서) |\n| **AC2 RequestQueue 403** | 접근상실 후 큐에 남은 오프라인 메시지 push → 서버 재판정 403 → **영구 실패 분류·무한 재시도 금지** (기존 SC-sync 4xx 즉시제거 정책 재사용). 접근상실+purge 시 해당 Section 대상 pending outbox **선제 제거** |\n| **AC3 grant-0 처리** | F항 케이스분할 적용. **자동 public 전환 절대 금지** |\n| **AC4 서버 최종인가 범위** | private Section 의 모든 경로에서 서버 재판정 필수 — ①메타(목록·제목·존재) ②메시지 목록·단건 ③전송·수정·삭제 ④첨부 signed URL 발급(**Section 접근 검사 — 첨부 존재만으로 부족**) ⑤활동피드·대시보드 ⑥검색(비멤버 제외) ⑦알림·FCM(비멤버 미발송) ⑧content_links 참조 해석(비접근→403). **클라 차단=낙관적 UX뿐·서버가 인가 권위** |\n\n### 권한 정책 (D3·D4 — 단일 진실은 domain.md §3-6-A·§3-6-B)\n\n- **D3=B (오버사이트 = 메타 전용):** manager+ 는 접근 grant 없는 private Section 에 대해 **존재·제목·멤버 수 등 메타만** 열람. **내용 열람에는 `sections.group_id` 를 통한 명시 그룹 연결 + 그 그룹 멤버십 필요** — 관리 role 만으로 자동 우회 없음.\n- **D4 (그룹 mutation = manager+ 전용):** `groups` 생성·해체, `sections.group_id` 연결·해제(섹션 수정), `group_members` 관리는 `binder_members.role ≤ 1`(master·manager)만. editor·member 는 서비스 레이어 403. 일반 멤버는 그룹명 조회·자기 라벨 선택만.\n\n### section_messages\n\n| 컬럼 | 설계 의도 |\n|------|----------|\n| `content TEXT` (Nullable) | **마크다운 텍스트**. null 허용 — 첨부파일·임베드·투표만 있는 메시지 가능 |\n| 삭제 방식 | `deleted_at` 기록 + content 유지. 클라이언트가 UI에서 \"삭제된 메시지\" 처리 |\n| `parent_id ON DELETE SET NULL` | 답글 대상 삭제 시 답글은 유지, 부모 참조만 null (\"삭제된 메시지에 대한 답글\" UI 가능) |\n| `mention_everyone` 별도 컬럼 | @everyone 여부를 message_mentions 조회 없이 빠르게 확인 |\n| `is_pinned` 별도 컬럼 | 핀 여부를 JOIN 없이 조회 |\n| `pinned_at` (신규 F7) | TIMESTAMPTZ Nullable. 핀 시각 (정렬·표시용). is_pinned=false면 null |\n);\nCREATE INDEX idx_sections_sync ON sections (binder_id, updated_at);\n-- 그룹→해당 그룹이 게이팅하는 섹션 역조회 (revoke 접근집합 재계산·grant-0 판정)\nCREATE INDEX idx_sections_group ON sections (group_id) WHERE deleted_at IS NULL;\n\n-- event_sections (events → section M:N)\n-- 먼저 section 생성 후 FK 가능\nCREATE TABLE event_sections (\n  event_id   UUID        NOT NULL,\n  section_id  UUID        NOT NULL,\n  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),\n  updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),\n  deleted_at TIMESTAMPTZ,\n  PRIMARY KEY (event_id, section_id),\n  CONSTRAINT fk_esec_event  FOREIGN KEY (event_id)  REFERENCES events(id),\n  CONSTRAINT fk_esec_section FOREIGN KEY (section_id) REFERENCES sections(id)\n);\n\n-- task_sections (tasks → section M:N)\nCREATE TABLE task_sections (\n  task_id    UUID        NOT NULL,\n  section_id  UUID        NOT NULL,\n  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),\n  updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),\n  deleted_at TIMESTAMPTZ,\n  PRIMARY KEY (task_id, section_id),\n  CONSTRAINT fk_tsec_task   FOREIGN KEY (task_id)   REFERENCES tasks(id),\n  CONSTRAINT fk_tsec_section FOREIGN KEY (section_id) REFERENCES sections(id)\n);\n\n\n-- ============================================================\n-- SECTION 5.6: GROUPS & SECTION ACCESS\n-- 2026-07-22 확정 — 바인더 내 수평 그룹 접근제어 2테이블 + sections.group_id 스칼라 FK.\n-- private Section 접근 = sections.group_id ⋈ group_members 단일 경로 (개인 직접 지정 없음).\n-- 섹션↔그룹은 1:N (한 Section 은 최대 한 group, 한 group 은 여러 Section). 링크는 별도\n--   테이블이 아닌 sections.group_id 컬럼(§5.5). 여러 그룹을 원하면 그룹을 새로 만들어\n--   각 Section 에 연결(1:1 복수 인스턴스). design_intent.md §7-A.\n--\n-- 스키마 현실 매핑: 설계 스펙의 \"binder_member_id → binder_members(id)\" 는\n--   binder_members 가 복합 PK(binder_id, user_id)·surrogate id 없음이므로 user_id → users(id)\n--   로 매핑한다. 바인더 범위는 groups.binder_id 로 고정된다(그룹의 binder = 섹션의 binder).\n-- updated_at: 설계 스케치엔 없으나 revoke tombstone delta pull(AC1·§7-A E항)이 delta cursor 에\n--   의존하므로 Rally sync 규약(idx_*_sync ON (scope, updated_at))에 맞춰 포함한다.\n-- ============================================================\n\nDROP TABLE IF EXISTS group_members  CASCADE;\nDROP TABLE IF EXISTS groups         CASCADE;\n\nCREATE TABLE groups (\n  id          UUID        NOT NULL,\n  binder_id   UUID        NOT NULL,\n  name        TEXT        NOT NULL,\n  -- 컬러 명찰 (식별 라벨). NULL=무색. 명찰 렌더용으로 binder 전 멤버 sync(로스터·링크는 스코프)\n  color       TEXT,\n  -- 생성자 (감사). 탈퇴 시 SET NULL. 사람 참조는 Rally 규약대로 users(id)\n  created_by  UUID,\n  created_at  TIMESTAMPTZ NOT NULL DEFAULT now(),\n  updated_at  TIMESTAMPTZ NOT NULL DEFAULT now(),\n  deleted_at  TIMESTAMPTZ,\n  PRIMARY KEY (id),\n  CONSTRAINT fk_grp_binder  FOREIGN KEY (binder_id)  REFERENCES binders(id),\n  CONSTRAINT fk_grp_creator FOREIGN KEY (created_by) REFERENCES users(id) ON DELETE SET NULL\n);\nCREATE INDEX idx_groups_sync ON groups (binder_id, updated_at);\n\nCREATE TABLE group_members (\n  id          UUID        NOT NULL,\n  group_id    UUID        NOT NULL,\n  -- 설계 스펙 binder_member_id = (group.binder_id, user_id). Rally 규약대로 user_id → users(id)\n  user_id     UUID        NOT NULL,\n  created_at  TIMESTAMPTZ NOT NULL DEFAULT now(),\n  updated_at  TIMESTAMPTZ NOT NULL DEFAULT now(),\n  deleted_at  TIMESTAMPTZ,\n  PRIMARY KEY (id),\n  CONSTRAINT fk_gm_group FOREIGN KEY (group_id) REFERENCES groups(id),\n  CONSTRAINT fk_gm_user  FOREIGN KEY (user_id)  REFERENCES users(id)\n);\n-- 활성 멤버십 유일성 (soft delete 후 재추가 허용 — 부분 유니크, PG 인라인 불가)\nCREATE UNIQUE INDEX uq_group_members_active ON group_members (group_id, user_id)\n  WHERE deleted_at IS NULL;\n-- revoke sync(E항): 자기 멤버십 delta·tombstone 을 user_id 스코프(접근필터 미적용)로 pull\nCREATE INDEX idx_gm_user_sync ON group_members (user_id, updated_at);\n-- 그룹 로스터 조회\nCREATE INDEX idx_gm_group ON group_members (group_id) WHERE deleted_at IS NULL;\n\n-- 섹션↔그룹 링크 = sections.group_id 스칼라 FK (별도 링크 테이블 없음, 1:N).\n-- groups 생성 후 추가 — sections 는 §5.5 에서 groups 보다 먼저 생성되므로 여기서 ALTER.\n-- 그룹 삭제 시 SET NULL → private Section 이 0-member lock 상태로 잔존(D3 재배정). 판정: design_intent §7-A.\nALTER TABLE sections\n  ADD CONSTRAINT fk_sec_group FOREIGN KEY (group_id)\n    REFERENCES groups(id) ON DELETE SET NULL;\n\n-- 대표 그룹 명찰 FK (groups 생성 후 추가 — 순환 참조 회피). 그룹 삭제 시 SET NULL.\nALTER TABLE binder_members\n  ADD CONSTRAINT fk_bm_primary_group FOREIGN KEY (primary_group_id)\n    REFERENCES groups(id) ON DELETE SET NULL;\n\n\n-- ============================================================\n-- SECTION 6: SPECIAL DAYS\n-- ============================================================\n\nDROP TABLE IF EXISTS holidays     CASCADE;\nDROP TABLE IF EXISTS special_days CASCADE;\n\n-- 반복 모델 = 단일 row + rrule 파싱 (인스턴스 테이블 없음 — iCal/Google 방식).\n-- event_instances·task_instances 처럼 인스턴스를 materialize 하지 않고,\n-- 클라 DAO 가 rrule(+is_yearly/is_lunar 플래그)을 파싱해 표시 날짜를 계산. SC-special-day §6-0.\nCREATE TABLE special_days (\n  id             UUID        NOT NULL,\n","exit_code":0,"status":"completed"}}
