ter the DDL path conflict is resolved.\nmigrations/20260722_group_section_access.sql:15:COMMENT ON COLUMN sections.access_scope IS '0=public (active binder members), 1=private (group_id membership)';\nmigrations/20260722_group_section_access.sql:31:  group_id UUID NOT NULL REFERENCES groups(id),\nmigrations/20260722_group_section_access.sql:37:CREATE UNIQUE INDEX uq_group_members_active ON group_members (group_id, user_id) WHERE deleted_at IS NULL;\nmigrations/20260722_group_section_access.sql:39:CREATE INDEX idx_gm_group ON group_members (group_id) WHERE deleted_at IS NULL;\nmigrations/20260722_group_section_access.sql:41:ALTER TABLE sections ADD COLUMN group_id UUID;\nmigrations/20260722_group_section_access.sql:42:ALTER TABLE sections ADD CONSTRAINT fk_sec_group FOREIGN KEY (group_id) REFERENCES groups(id) ON DELETE SET NULL;\nmigrations/20260722_group_section_access.sql:43:CREATE INDEX idx_sections_group ON sections (group_id) WHERE deleted_at IS NULL;\nmigrations/20260722_group_section_access.sql:45:ALTER TABLE binder_members ADD COLUMN primary_group_id UUID;\nmigrations/20260722_group_section_access.sql:47:  FOREIGN KEY (primary_group_id) REFERENCES groups(id) ON DELETE SET NULL;\nmigrations/20260722_group_section_access.down.sql:2:ALTER TABLE binder_members DROP COLUMN IF EXISTS primary_group_id;\nmigrations/20260722_group_section_access.down.sql:5:ALTER TABLE sections DROP COLUMN IF EXISTS group_id;\nsrc/daos/binderDAO.js:225:       FROM groups g WHERE gm.group_id = g.id AND g.binder_id = $1 AND gm.user_id = $2 AND gm.deleted_at IS NULL`,\nsrc/daos/groupDAO.js:26:       LEFT JOIN group_members gm ON gm.group_id = g.id AND gm.deleted_at IS NULL\nsrc/daos/groupDAO.js:46:       WHERE group_id = $1 AND deleted_at IS NULL`, [groupId]\nsrc/daos/groupDAO.js:56:      `INSERT INTO group_members (id, group_id, user_id) VALUES ($1, $2, $3)\nsrc/daos/groupDAO.js:57:       RETURNING id, group_id, user_id, created_at, updated_at`, [id, groupId, userId]\nsrc/daos/groupDAO.