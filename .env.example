# .env.example — 자리표시자만 있다. 실제 값은 여기 적지 않는다.
#
# 사용법: 이 파일을 .env로 복사하고 값을 채운다 (`.gitignore`가 `.env`는 무시하지만
# `.env.example`은 무시하지 않는다 — 2026-08-08 `git check-ignore`로 확인).
#   cp .env.example .env
#
# `src/configs/env.js`가 dotenv로 이 파일을 읽고, `src/configs/index.js`가 module-load
# 시점에 동기적으로 `./db`·`./firebase`를 require한다 — 아래 "필수" 항목이 하나라도
# 없으면 `requireEnv()`가 즉시 throw하고, 이 require는 server.js의 try/catch 바깥이라
# **콘솔 로그 한 줄 없이 프로세스가 죽는다** (RLY-20260806-199 실측, README.md §2 참고).

# ============================================================
# 필수 — DB 접속 (NODE_ENV에 따라 둘 중 한 그룹만 필요하다)
# ============================================================

# dev (NODE_ENV가 'production'이 아닐 때 — 기본값도 이쪽. Neon Serverless PostgreSQL 기준)
PGHOST=
PGUSER=
PGPASSWORD=
PGDATABASE=

# prod (NODE_ENV=production일 때만. GCP Cloud SQL 기준 — dev 블록과 동시에 채울 필요 없다)
# DB_HOST=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# ============================================================
# 필수 — dev·prod 공통
# ============================================================

FIREBASE_PROJECT_ID=

# ============================================================
# 선택 — 기본값이 코드에 있다 (없어도 기동은 된다)
# ============================================================

NODE_ENV=development
PORT=3000
# DB_PORT는 prod(Cloud SQL) 접속에서만 쓰인다 — 기본 5432
DB_PORT=5432
CORS_ORIGINS=
GCS_BUCKET_MEDIA=rally-media
GCS_BUCKET_CDN=rally-cdn
# 0=직접 연결(dev) 1=nginx 단일 프록시 2=CDN+nginx 등
TRUST_PROXY_HOPS=0
# Firebase Admin SDK 서비스 계정 키 경로 — 없으면 null로 기본 자격 증명 탐색을 시도한다
GOOGLE_APPLICATION_CREDENTIALS=

# ============================================================
# 선택 — 기능별 (없으면 그 기능만 조용히 비활성/오작동. 서버 기동 자체는 막지 않는다)
# ============================================================

# App Store Server Notifications 웹훅 검증(webhookAuthMiddleware.js)
APPLE_ENVIRONMENT=Sandbox
APPLE_ROOT_CA_PATH=

# 앱 강제 업데이트 배너(expressLoader.js)
APP_MINIMUM_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
APP_FORCE_UPDATE=false
APP_UPDATE_URL_IOS=
APP_UPDATE_URL_ANDROID=

# 미디어 CDN URL(mediaWorkerJobs.js)
CDN_BASE_URL=https://cdn.rallyapp.io

# Google Play Developer API 웹훅 검증·구독 조회(webhookAuthMiddleware.js·webhookService.js)
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# 공휴일 배치(holidayJobs.js) — 공공데이터포털 API 키
HOLIDAYS_KR_API_KEY=

# ============================================================
# 서버 기동과 무관 — 특정 테스트 파일만 읽는다 (.env에 넣을 필요 없음)
# ============================================================

# recurrenceGoldenVectorRegression.test.js가 클라 저장소의 골든 벡터 fixture를 찾을 때만
# 사용(형제 디렉터리 자동 탐색이 실패하는 환경에서만 필요 — 클라 README.md §4의
# RALLY_SERVER_REPO와 대칭 관계).
# RALLY_CLIENT_REPO=

# recurrenceExpansion.test.js가 테스트 도중 process.env.TZ를 직접 바꿔가며 검증한다 —
# .env로 미리 설정해 둘 필요 없음(테스트가 자체적으로 저장·복원한다).
